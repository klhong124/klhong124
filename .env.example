# Copy to `.env.local` and fill in. Never commit real values.

# --- Contact form (required for the form to send) ---------------------------
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend.
# Leave unset to fall back to Resend's onboarding sender, which needs no
# verification but can only deliver to the Resend account owner's address.
# CONTACT_FROM_EMAIL="Ryan Kwan Portfolio <hello@ryankwan.dev>"

# Where enquiries are delivered. Defaults to profile.email in
# data/portfolio-content.ts.
# CONTACT_TO_EMAIL=

# --- PostHog (optional) ----------------------------------------------------
# The provider is not currently mounted in app/layout.tsx. Set these and
# re-enable it if you want product analytics.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
